# Copy to `.env` (gitignored) and fill in. Never commit real values.

# User-supplied Meta Model API key. Read from this file by tooling; never pass it as a
# command argument.
META_API_KEY=

# Model choice is configuration (ruling R5, docs/adr/0003-meta-model-selection.md).
# Test model: cheapest Meta model that passed schema output, streaming and search. It is a
# Contributor-mode model (Meta may train on prompts): synthetic or public inputs only.
NESSA_META_TEST_MODEL=muse-spark-1.3-contributor
# Production model: Standard mode only (a `-contributor` ID is rejected at startup).
NESSA_META_PRODUCTION_MODEL=muse-spark-1.3
